#!/usr/bin/env bash
# nypc-push — 노트북의 소스를 서버에 올리고 바로 컴파일해서 오류를 돌려받습니다.
# 내 노트북에서 실행합니다. 편의 도구일 뿐이라 scp 로 직접 올려도 됩니다.
#
#   nypc-push                     클립보드 내용을 올려서 컴파일
#   nypc-push bot.cpp             파일을 올려서 컴파일
#   nypc-push -n greedy           이름 지정 (기본: 파일명 또는 chat)
#   nypc-push -m native           빌드 모드 (judge|native|static, 기본 judge)
#   nypc-push --no-build          올리기만
#
# 클립보드에 ```cpp ... ``` 코드 블록이 들어 있으면 알아서 벗겨냅니다.
# 대화형 모델 답변을 설명 문장째 복사해도 됩니다.
set -euo pipefail

ALIAS="${NYPC_SSH_ALIAS:-nypc}"
REMOTE_DIR="bots"
MODE=judge
NAME=""
BUILD=1
SRC_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name) NAME="$2"; shift 2 ;;
    -m|--mode) MODE="$2"; shift 2 ;;
    --no-build) BUILD=0; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "알 수 없는 옵션: $1" >&2; exit 2 ;;
    *) SRC_FILE="$1"; shift ;;
  esac
done

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
raw="${tmp}/raw"

if [[ -n "$SRC_FILE" ]]; then
  [[ -f "$SRC_FILE" ]] || { echo "파일이 없습니다: $SRC_FILE" >&2; exit 2; }
  cp "$SRC_FILE" "$raw"
  [[ -n "$NAME" ]] || NAME="$(basename "${SRC_FILE%.*}")"
else
  if command -v pbpaste >/dev/null 2>&1; then pbpaste > "$raw"
  elif command -v wl-paste >/dev/null 2>&1; then wl-paste > "$raw"
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o > "$raw"
  else echo "클립보드를 읽을 수 없습니다. 파일 경로를 넘기세요." >&2; exit 2; fi
  [[ -s "$raw" ]] || { echo "클립보드가 비었습니다." >&2; exit 2; }
  [[ -n "$NAME" ]] || NAME=chat
fi

# ```cpp ... ``` 코드 블록이 있으면 제일 긴 것만 남깁니다 (설명 문장 제거).
src="${tmp}/src.cpp"
python3 - "$raw" "$src" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
blocks = re.findall(r"```[a-zA-Z+]*\n(.*?)```", text, re.S)
out = max(blocks, key=len) if blocks else text
open(sys.argv[2], "w", encoding="utf-8").write(out)
print(f"코드 블록 {len(blocks)}개 중 가장 긴 것을 사용" if blocks else "코드 블록 표시 없음 — 전체를 사용")
PY

if ! grep -qE '^\s*#\s*include|int\s+main' "$src"; then
  echo "경고: C++ 소스처럼 보이지 않습니다 (#include 도 main 도 없음)." >&2
  echo "      그래도 올립니다. 컴파일 오류가 나면 붙여넣기를 다시 확인하세요." >&2
fi

[[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "이름에 쓸 수 없는 문자: $NAME" >&2; exit 2; }
STAMP="$(date +%m%d-%H%M%S)"
REMOTE_SRC="${REMOTE_DIR}/${NAME}-${STAMP}.cpp"
REMOTE_BIN="${REMOTE_DIR}/bin/${NAME}-${STAMP}"

lines=$(wc -l < "$src" | tr -d ' ')
bytes=$(wc -c < "$src" | tr -d ' ')
echo "올리는 중: ${REMOTE_SRC}  (${lines}줄, ${bytes}바이트)"

ssh -o BatchMode=yes "$ALIAS" "mkdir -p ${REMOTE_DIR}/bin"
scp -q "$src" "${ALIAS}:${REMOTE_SRC}"

if [[ "$BUILD" -eq 0 ]]; then
  echo "업로드 완료 (빌드 안 함): ~/${REMOTE_SRC}"
  exit 0
fi

echo "컴파일 중 (mode=${MODE})..."
set +e
out="$(ssh -o BatchMode=yes "$ALIAS" \
  "~/shared/tools/build.sh ~/${REMOTE_SRC} -m ${MODE} -o ~/${REMOTE_BIN} 2>&1")"
rc=$?
set -e
printf '%s\n' "$out" | grep -v '^+ g++' || true

if [[ $rc -eq 0 ]]; then
  cat <<EOF

컴파일 성공
  소스     ~/${REMOTE_SRC}
  바이너리 ~/${REMOTE_BIN}

서버에서:
  ssh ${ALIAS}
  ~/${REMOTE_BIN} NYPC
EOF
else
  echo
  echo "컴파일 실패 (rc=${rc}). 위 오류를 모델에 그대로 붙여넣으세요."
  echo "소스는 남아 있습니다: ~/${REMOTE_SRC}"
  exit "$rc"
fi
